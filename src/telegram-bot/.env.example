# Telegram Bot Environment Variables
# Copy this file to .env in the telegram-bot directory and fill in your actual values

# Telegram Bot Token (get from @BotFather on Telegram)
# Format: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Supabase Configuration
# Get these from your Supabase project settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Webhook Secret (use a strong random string)
# Must match the VITE_WEBHOOK_SECRET in your frontend .env file
# Generate one with: openssl rand -hex 32
WEBHOOK_SECRET=your-webhook-secret-here

# Optional: Port for the webhook API (defaults to 5000)
PORT=5000
