# Frontend Environment Variables (Vite)
# Copy this file to .env and fill in your actual values
# Vite requires the VITE_ prefix for environment variables to be exposed to the client

# Telegram Webhook API URL (where your webhook_api.py is deployed)
# Example: https://your-webhook-api.railway.app or https://your-api.render.com
VITE_WEBHOOK_API_URL=https://your-webhook-api.railway.app

# Webhook Secret (use a strong random string)
# Generate one with: openssl rand -hex 32
VITE_WEBHOOK_SECRET=your-webhook-secret-here

# Enable/disable Telegram notifications (true/false)
VITE_TELEGRAM_NOTIFICATIONS_ENABLED=true
